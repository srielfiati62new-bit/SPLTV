# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GAS_ENDPOINT_URL: URL Web App Google Apps Script hasil deployment (server-side only).
GAS_ENDPOINT_URL=""

# GAS_SHARED_SECRET: Token rahasia opsional untuk validasi permintaan ke Google Apps Script.
GAS_SHARED_SECRET=""

# GOOGLE_SPREADSHEET_ID: ID Google Spreadsheet default untuk integrasi langsung Google Sheets API (opsional).
GOOGLE_SPREADSHEET_ID=""

# TEACHER_ACCESS_PIN: PIN akses untuk membuka halaman Dashboard Guru (server-side only).
TEACHER_ACCESS_PIN="SMK-SPLTV-2026"
